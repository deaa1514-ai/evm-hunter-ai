# ============================================
# EVM Bounty Hunter — Environment Variables
# ============================================

# REQUIRED: Etherscan V2 API Key
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY_HERE

# REQUIRED: Ethereum RPC URL
# Infura: https://infura.io (free tier available)
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# OPTIONAL: Claude AI for intelligent exploit analysis
# Get from: https://console.anthropic.com
# Without this, heuristic scoring is used
ANTHROPIC_API_KEY=

# OPTIONAL: Other chain RPC URLs
BASE_RPC_URL=https://base-mainnet.infura.io/v3/YOUR_INFURA_KEY
ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY
